# Welcome
print(" ")
print("Hi! Welcome to the Personal Profile and Age Calculator.")
print("Lets create you a personal profile, calculate approxiamtely how long you've been alive, and a future age!")
print("In order to do this, you will first answer some questions.")
print(" ")

# Information Gathering
name = input("First, what's your name? ")               # Asking the user for their first name
birth_year = int(input("What year were you born? "))    # Asking the user for their birth year
favorite_food = input("What's your favorite food? ")    # Asking the user for their favorite food
favorite_hobby = input("What's your favorite hobby? ")  # Asking the user for their favorite hobby
city = input("What city do you live in? ")              # Asking the user what city they live in
favorite_sport = input("What's your favorite sport? ")  # Asking the user for their favorite sport
favorite_subject = input("What's your favorite subject? ")  # Asking the user for their favorite subject
future_year = int(input("Enter a future year: "))       # Asking the user for a future year that they would like to know the age they will be

# Calculations
age = 2026 - birth_year         # Calculating the user's age by subtracting their birth year from the current year
months_alive = age * 12         # Calculating how many months the user has been alive by multiplying their age by 12
days_alive = age * 365          # Calculating how many days the user has been alive by multiplying their age by 365
hours_alive = days_alive * 24   # Calculating how many hours the user has been alive by multiplying how many days they have been alive by 24
minutes_alive = hours_alive * 60    # Calculating how many minutes the user has been alive by multiplying their hours alive by 60
seconds_alive = minutes_alive * 60  # Calculating how many seconds the user has been alive by multiplying their minutes alive by 60

# Future Calculations
future_age = future_year - birth_year # Calculating the user's future age by subrating their birth year from their chosen future year

# Display name and age calculations
print(" ")
print("Here's your profile:")
print(" ")
print("Name: " + name)
print("Age: Approximately " + str(age) + " years old")
print(" ")
print("You've been alive for approximately " + str(months_alive) + " months, " + str(days_alive) + " days, " + str(hours_alive) + " hours, " + str(minutes_alive) + " minutes, and " + str(seconds_alive) + " seconds!")
print(" ")

# Display other information
print("Other Information: ")
print("Your favorite food is " + favorite_food + ".")
print("Your favorite hobby is " + favorite_hobby + ".")
print("Your favorite sport is " + favorite_sport + ".")
print("Your favorite subject is " + favorite_subject + ".")
print("You live in " + city + ".")
print("You will be " + str(future_age) + " years old in " + str(future_year) + "!")
print(" ")

